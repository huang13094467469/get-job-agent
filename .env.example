# ===== LLM（对话/工具调用）提供商选择 =====
# deepseek = 官方 DeepSeek（需 API Key）；lmstudio = 本地 LM Studio（无 Key）
LLM_PROVIDER=deepseek

# ---- DeepSeek 官方 ----
DEEPSEEK_API_KEY=sk-
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 本地 LM Studio ----
LMSTUDIO_BASE_URL=http://192.168.1.20:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b
LMSTUDIO_API_KEY=

# ===== 持久化 PostgreSQL =====
# 业务库：唯一的简历存储（resumes 表，启动时自动建）；checkpoint 库由代码自动建（默认 get_job_agent_ckpt，如需改名设 CHECKPOINT_DB）
POSTGRES_HOST=192.168.1.200
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=boss_agent

# ===== Local Agent Server =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8791

# ===== 运行观测 / 追踪（Tracing）=====
# LangSmith 云端追踪（可选，需账号+API Key，会外发到 smith.langchain.com）：
# 开启后 create_deep_agent 每一步（模型/工具/耗时/token）自动上报，便于评估。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=get-job-agent
# 自建/兼容端点留空即用官方；如用自托管 LangSmith 填其 URL
LANGSMITH_ENDPOINT=

# 本地结构化 trace（默认开启，不外发）：每次运行的正常/异常事件按 JSONL 落盘，供离线回放/评估
TRACE_LOCAL_ENABLED=true
TRACE_FILE=logs/agent_traces.jsonl
# 连续同类工具软错误达到该次数即升级告警（定位「页面断开仍反复重试」）
TRACE_ERROR_STREAK=3

# ===== Agent 运行模式（自主程度）=====
# unattended = 无人值守：自动发送打招呼（不暂停）+ 自动续跑逐岗位走完闭环
# confirm    = 每次发送前暂停，等面板人工确认
AGENT_MODE=unattended
# 单轮自动打招呼的安全上限；0 = 不限（直到列表跑完）
MAX_GREETINGS_PER_RUN=20